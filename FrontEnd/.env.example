# Copy this file to .env in the FrontEnd folder.
# These are the only environment variables the frontend needs.
# VITE_STRIPE_PUBLISHABLE_KEY is a publishable (public) key — it is safe
# to expose in the browser. Never put a Stripe SECRET key here.

# Backend API base URL
VITE_API_URL=http://localhost:3000

# Stripe publishable key (Dashboard > Developers > API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_<your-test-publishable-key>
