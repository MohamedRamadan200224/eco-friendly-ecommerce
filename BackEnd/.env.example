# Copy this file to config.env in the BackEnd folder and fill in real values.
# server.js loads ./config.env. Never commit config.env (or any real
# secrets) — it is gitignored. These are placeholders only.
#
# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
DATABASE=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT — must be a long random string (e.g. 64+ characters from a password
# generator). The server refuses to start without it.
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Frontend origin, used for CORS and for password-reset / Stripe redirect URLs
FRONTEND_URL=http://localhost:5173

# Stripe (https://dashboard.stripe.com/apikeys)
# Secret key — server-side only, never put it in the frontend.
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>
# Webhook signing secret, from the Stripe webhook endpoint you create
# (Dashboard > Developers > Webhooks, or `stripe listen` in development).
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>
# Optional Stripe coupon ids for discounts (leave empty to disable).
# The reward-points coupon is only applied when a user has 100+ points.
# Blank means no coupon is applied — do not put a fake id here, Stripe
# would reject the checkout. Get real ids from Dashboard > Products >
# Coupons (test mode) when you want discounts enabled.
STRIPE_REWARD_COUPON_ID=
STRIPE_ECO_COUPON_ID=

# Demo seed data (BackEnd/dev-data/seed.js — `npm run seed`).
# SEED_PASSWORD is the password for the three demo accounts
# (admin@greengray.demo, seller@greengray.demo, demo@greengray.demo).
# Demo-only — the seed stores it hashed, exactly like a real signup.
# The default below is what seed.js uses when this is unset; never use
# it anywhere real, and change it if you seed a shared database.
SEED_PASSWORD=password123

# Legacy import script only (BackEnd/dev-data/data/import-dev-data.js).
# The new `npm run seed` does not use this. Only needed if you run the
# old import script, whose DATABASE string contains a <PASSWORD>
# placeholder that gets replaced with this value.
DATABASE_PASSWORD=<your-database-password>

# Email (password-reset + certificates)
EMAIL_FROM=noreply@example.com
GMAIL_EMAIL=<your-gmail-address>
GMAIL_PASSWORD=<your-gmail-app-password>

# Demo seed data (dev-data/seed.js, `npm run seed`)
# Password for the three demo accounts (admin@greengray.demo,
# seller@greengray.demo, demo@greengray.demo). Demo-only: change it if
# you like, but never use a real password here — the seed accounts are
# throwaway demo logins and the value is only used locally.
SEED_PASSWORD=password123
